# Exemple de fichier .env pour l'agent IA en Python
# Copiez ce fichier en .env et remplissez avec vos clés API.

# Clé API pour Tavily (recherche web)
# Obtenez votre clé sur: https://tavily.com/
TAVILY_API_KEY=votre_cle_api_tavily

# Clé API pour Mistral AI
# Obtenez votre clé sur: https://console.mistral.ai/
MISTRAL_API_KEY=votre_cle_api_mistral

# Alternative: Si vous utilisez OpenAI
# OPENAI_API_KEY=votre_cle_api_openai
