# Exemple de fichier .env pour le frontend React
# Copiez ce fichier en .env et remplissez avec vos valeurs

# URL de l'API backend (par défaut : http://localhost:8081/api)
REACT_APP_API_URL=http://localhost:8081/api

# Port du serveur de développement (par défaut : 3000)
PORT=3000

# Variables pour le build
# GENERATE_SOURCEMAP=false

# Variables pour le déploiement
# PUBLIC_URL=/agentic-ai
